{
  "port": 8330,
  "coordinator_ip": "192.168.1.136",

  "min_volume": 8,
  "max_volume": 60,
  "room_volume_offsets": {},
  "crossfade": true,
  "queue_ahead": 2,

  "genres": {
    "chill":      { "label": "Chill",      "sources": { "chillify": ["chill"] } },
    "jazzy_cafe": { "label": "Jazzy Cafe", "sources": { "chillify": ["jazzy", "cafe"] } },
    "asian":      { "label": "Asian",      "sources": { "chillify": ["asian"] } }
  },
  "default_genres": ["chill"],

  "daypart_curve": [
    [0,  0.18, 20, "late night"],
    [6,  0.25, 24, "early morning"],
    [9,  0.35, 30, "morning"],
    [13, 0.45, 36, "afternoon"],
    [16, 0.45, 36, "afternoon"],
    [18, 0.35, 32, "early evening"],
    [21, 0.25, 26, "evening"],
    [24, 0.18, 20, "late night"]
  ],
  "reset_trims_on_daypart": true,

  "weather": {
    "clear":  { "energy": 0.00,  "volume": 0,  "boost": {} },
    "cloudy": { "energy": -0.03, "volume": 0,  "boost": { "jazzy_cafe": 1.4 } },
    "rain":   { "energy": -0.08, "volume": -2, "boost": { "jazzy_cafe": 2.2 } }
  },
  "unselected_boost_base": 0.35,

  "occupancy": { "threshold": 50, "max_energy": 0.12, "max_volume": 6 },

  "cache": {
    "max_mb": 2000,
    "warm_per_genre": 40,
    "prefer_local": true,
    "analyse_remote": true
  },

  "chillify": {
    "enabled": true,
    "catalog_url": "https://chillify.me/api/library",
    "track_base": "https://chillify.me/tracks/"
  },

  "mock_track_seconds": 45,

  "live": {
    "timezone": null,
    "capacity": null,
    "stale_after_minutes": 15,
    "override_minutes": 60,
    "weather": { "lat": null, "lon": null, "poll_seconds": 600 },
    "occupancy": {
      "supabase_url": "",
      "key_env": "O3_SUPABASE_KEY",
      "mode": "count",
      "table": "",
      "site_column": "",
      "site_value": null,
      "start_column": "",
      "end_column": "",
      "max_visit_hours": 8,
      "extra_filters": {},
      "rpc": "",
      "rpc_args": {},
      "result_key": "count",
      "poll_seconds": 60
    }
  }
}
